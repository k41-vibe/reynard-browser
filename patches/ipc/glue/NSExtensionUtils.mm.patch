+static dispatch_queue_t ExtensionLaunchQueue() {
+  static dispatch_queue_t queue;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    queue = dispatch_queue_create("com.minh-ton.Reynard.ExtensionLaunchQueue",
+                                  DISPATCH_QUEUE_SERIAL);
+  });
+  return queue;
+}
+
+static dispatch_queue_t ExtensionCompletionQueue() {
+  static dispatch_queue_t queue;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    queue = dispatch_queue_create(
+        "com.minh-ton.Reynard.ExtensionCompletionQueue", DISPATCH_QUEUE_SERIAL);
+  });
+  return queue;
+}
+
+static NSError* ExtensionLaunchError(NSString* description,
+                                     NSError* _Nullable underlying = nil) {
+  NSDictionary* userInfo = underlying
+                               ? @{
+                                   NSLocalizedDescriptionKey : description,
+                                   NSUnderlyingErrorKey : underlying,
+                                 }
+                               : @{NSLocalizedDescriptionKey : description};
+  return [NSError errorWithDomain:@"ReynardExtension" code:1 userInfo:userInfo];
+}
+
+// When running inside LiveContainer, the guest binary is dlopen'ed by the host
+// (and LiveProcess may load this code from the extension). Locate our own .app
+// by walking up from this image's path on disk.
+static NSURL* _Nullable FindOwnAppBundleURL() {
+  Dl_info info = {};
+  if (!dladdr((void*)FindOwnAppBundleURL, &info) || !info.dli_fname) {
+    return nil;
+  }
+  NSURL* url = [NSURL fileURLWithPath:@(info.dli_fname)];
+  for (int i = 0; i < 4 && url; i++) {
+    url = url.URLByDeletingLastPathComponent;
+    if (!url) {
+      break;
+    }
+    if ([url.pathExtension isEqualToString:@"app"]) {
+      return url;
+    }
+  }
+  return nil;
+}
+
+static NSURL* _Nullable GetOwnExtensionURL() {
+  NSURL* appURL = FindOwnAppBundleURL();
+  if (!appURL) {
+    appURL = [[NSBundle mainBundle] bundleURL];
+  }
+  return [appURL URLByAppendingPathComponent:@"PlugIns/Reynard Helper.appex"];
+}
+
+static NSString* _Nullable GetExtensionIdentifier() {
+  NSURL* extensionURL = GetOwnExtensionURL();
+  return [[NSBundle bundleWithURL:extensionURL] bundleIdentifier];
+}
+
+// LiveContainer hosts guest apps' App Extensions through its LiveProcess.appex
+// (see LiveProcess/main.m in the LiveContainer fork). Detect it in the host
+// bundle's PlugIns; absent when running as a normally installed app.
+// LiveContainer replaces [NSBundle mainBundle] with the guest app's bundle, so
+// its own bundle has to be taken from +[NSUserDefaults lcMainBundle].
+static NSString* _Nullable GetLiveProcessExtensionIdentifier() {
+  SEL lcMainBundleSelector = NSSelectorFromString(@"lcMainBundle");
+  if (![NSUserDefaults respondsToSelector:lcMainBundleSelector]) {
+    return nil;
+  }
+  NSBundle* hostBundle =
+      ((NSBundle * (*)(id, SEL))objc_msgSend)([NSUserDefaults class],
+                                               lcMainBundleSelector);
+  NSURL* pluginsURL = [hostBundle builtInPlugInsURL];
+  if (!pluginsURL) {
+    return nil;
+  }
+  NSBundle* liveProcessBundle = [NSBundle bundleWithURL:
+      [pluginsURL URLByAppendingPathComponent:@"LiveProcess.appex"]];
+  if (!liveProcessBundle) {
+    return nil;
+  }
+  return liveProcessBundle.bundleIdentifier;
+}
+
+static NSData* _Nullable CreateAppDirectoryBookmark(NSURL* extensionURL) {
+  // PlugIns/<name>.appex -> containing .app
+  NSURL* appURL =
+      extensionURL.URLByDeletingLastPathComponent.URLByDeletingLastPathComponent;
+  if (!appURL) {
+    return nil;
+  }
+  NSError* error = nil;
+  // 1 << 11 matches LiveContainer's security-scoped bookmark creation
+  NSData* data = [appURL bookmarkDataWithOptions:(1 << 11)
+                    includingResourceValuesForKeys:nil
+                                     relativeToURL:nil
+                                             error:&error];
+  if (error) {
+    NSLog(@"Reynard: app dir bookmark creation failed: %@", error);
+  }
+  return data;
+}
+
+@interface ExtensionProcess : NSObject {
+ @private
+  NSExtension* mExtension;
+  NSXPCListener* mListener;
+  ExtensionConnectionDelegate* mListenerDelegate;
+  NSXPCConnection* mConnection;
+  NSUUID* mRequestIdentifier;
+  xpc_connection_t mLibXPCConnection;
+  bool mInvalidated;
+}
+
+- (void)startWithCompletion:
+    (void (^_Nonnull)(NSError* _Nullable error))aCompletion;
+- (xpc_connection_t _Nullable)copyLibXPCConnection;
+- (void)invalidate;
+
+@end
+
+@implementation ExtensionProcess
+
+- (void)startWithCompletion:
+    (void (^_Nonnull)(NSError* _Nullable error))aCompletion {
+  void (^completion)(NSError* _Nullable) = [aCompletion copy];
+
+  dispatch_async(ExtensionLaunchQueue(), ^{
+    __block bool completed = false;
+    void (^completeOnce)(NSError* _Nullable) = ^(NSError* _Nullable error) {
+      dispatch_async(ExtensionCompletionQueue(), ^{
+        if (completed) {
+          return;
+        }
+        completed = true;
+        completion(error);
+        [completion release];
+      });
+    };
+
+    if (mInvalidated) {
+      completeOnce(
+          ExtensionLaunchError(@"NSExtension process already invalidated"));
+      return;
+    }
+
+    mListenerDelegate = [[ExtensionConnectionDelegate alloc] init];
+    mListener = [[NSXPCListener anonymousListener] retain];
+
+    __block ExtensionProcess* process = self;
+    [mListenerDelegate setConnectionHandler:^(NSXPCConnection* connection) {
+      if (process->mInvalidated || process->mConnection) {
+        [connection invalidate];
+        return;
+      }
+
+      process->mConnection = [connection retain];
+      [process->mListenerDelegate setPingHandler:^{
+        completeOnce(nil);
+      }];
+      [process->mConnection
+          setExportedInterface:
+              [NSXPCInterface
+                  interfaceWithProtocol:@protocol(ExtensionBootstrapPing)]];
+      [process->mConnection setExportedObject:process->mListenerDelegate];
+      [process->mConnection setInvalidationHandler:^{
+        completeOnce(ExtensionLaunchError(
+            @"NSXPC connection invalidated before bootstrap"));
+      }];
+
+      xpc_connection_t libXPC = [process->mConnection _xpcConnection];
+      if (libXPC) {
+        process->mLibXPCConnection = xpc_retain(libXPC);
+      }
+
+      if (!process->mLibXPCConnection) {
+        completeOnce(ExtensionLaunchError(
+            @"Failed to get libxpc connection from NSXPCConnection"));
+        return;
+      }
+    }];
+
+    [mListener setDelegate:mListenerDelegate];
+    [mListener resume];
+
+    // The item handed to the child process: it carries our anonymous listener
+    // endpoint, which the child connects back to during bootstrap.
+    NSExtensionItem* childItem = [[[NSExtensionItem alloc] init] autorelease];
+    [childItem setUserInfo:@{@"ReynardXPCListenerEndpoint" : [mListener endpoint]}];
+
+    NSExtensionItem* hostItem = childItem;
+    NSError* extensionError = nil;
+
+    NSURL* ownExtensionURL = GetOwnExtensionURL();
+    NSString* liveProcessIdentifier = GetLiveProcessExtensionIdentifier();
+    if (liveProcessIdentifier && ownExtensionURL) {
+      // LiveContainer mode: the child extension is not registered with the
+      // system, so ask LiveContainer's LiveProcess.appex to host it. The
+      // endpoint is forwarded to the child inside lcGuestExtensionInputItems.
+      NSExtensionItem* containerItem =
+          [[[NSExtensionItem alloc] init] autorelease];
+      NSMutableDictionary* containerUserInfo = [NSMutableDictionary dictionary];
+      containerUserInfo[@"lcGuestExtensionPath"] = ownExtensionURL.path;
+      containerUserInfo[@"lcGuestExtensionInputItems"] = @[ childItem ];
+      NSString* principalClass = [[[NSBundle bundleWithURL:ownExtensionURL]
+          infoDictionary][@"NSExtension"] objectForKey:@"NSExtensionPrincipalClass"];
+      if (principalClass) {
+        containerUserInfo[@"lcGuestExtensionPrincipalClass"] = principalClass;
+      }
+      NSData* bookmark = CreateAppDirectoryBookmark(ownExtensionURL);
+      if (bookmark) {
+        containerUserInfo[@"bookmarks"] = @[ bookmark ];
+      }
+      [containerItem setUserInfo:containerUserInfo];
+      hostItem = containerItem;
+
+      mExtension = [[NSExtension extensionWithIdentifier:liveProcessIdentifier
+                                                   error:&extensionError] retain];
+    } else {
+      NSString* extensionIdentifier = GetExtensionIdentifier();
+      if (!extensionIdentifier) {
+        completeOnce(ExtensionLaunchError(
+            @"Unable to resolve extension bundle identifier"));
+        return;
+      }
+      mExtension = [[NSExtension extensionWithIdentifier:extensionIdentifier
+                                                   error:&extensionError] retain];
+    }
+
+    if (!mExtension) {
+      completeOnce(ExtensionLaunchError(@"Failed to create NSExtension",
+                                        extensionError));
+      return;
+    }
+
+    [mExtension setRequestInterruptionBlock:^(NSUUID* requestIdentifier) {
+      completeOnce(ExtensionLaunchError(
+          @"NSExtension request interrupted before bootstrap"));
+    }];
+    [mExtension setRequestCancellationBlock:^(NSUUID* requestIdentifier,
+                                              NSError* error) {
+      completeOnce(ExtensionLaunchError(
+          @"NSExtension request cancelled before bootstrap", error));
+    }];
+
+    __block NSUUID* requestIdentifier = nil;
+    __block bool requestReturned = false;
+    dispatch_semaphore_t semaphore = dispatch_semaphore_create(0);
+    [mExtension beginExtensionRequestWithInputItems:@[ hostItem ]
+                                         completion:^(NSUUID* identifier) {
+                                           requestIdentifier = [identifier copy];
+                                           requestReturned = true;
+                                           dispatch_semaphore_signal(semaphore);
+                                         }];
+    // Nested launches (LiveContainer inside the loop) can take a while
+    dispatch_semaphore_wait(semaphore,
+                            dispatch_time(DISPATCH_TIME_NOW, 20 * NSEC_PER_SEC));
+    if (!requestReturned || !requestIdentifier) {
+      completeOnce(ExtensionLaunchError(
+          @"Failed to start NSExtension request"));
+      return;
+    }
+    mRequestIdentifier = [requestIdentifier retain];
+
+    dispatch_after(
+        dispatch_time(DISPATCH_TIME_NOW, 25 * NSEC_PER_SEC),
+        ExtensionLaunchQueue(), ^{
+          completeOnce(ExtensionLaunchError(
+              @"Timed out waiting for child extension NSXPC connection"));
+        });
+  });
+}
+
+- (xpc_connection_t _Nullable)copyLibXPCConnection {
+  return mLibXPCConnection ? xpc_retain(mLibXPCConnection) : nullptr;
+}
+
+- (void)invalidate {
+  mInvalidated = true;
+
+  if (mLibXPCConnection) {
+    xpc_connection_cancel(mLibXPCConnection);
+    xpc_release(mLibXPCConnection);
+    mLibXPCConnection = nullptr;
+  }
+
+  if (mConnection) {
+    [mConnection invalidate];
+    [mConnection release];
+    mConnection = nil;
+  }
+
+  if (mExtension) {
+    if (mRequestIdentifier) {
+      [mExtension cancelExtensionRequestWithIdentifier:mRequestIdentifier];
+    }
+    [mExtension release];
+    mExtension = nil;
+  }
+
+  if (mRequestIdentifier) {
+    [mRequestIdentifier release];
+    mRequestIdentifier = nil;
+  }
+
+  if (mListener) {
+    [mListener setDelegate:nil];
+    [mListener invalidate];
+    [mListener release];
+    mListener = nil;
+  }
+
+  if (mListenerDelegate) {
+    [mListenerDelegate setConnectionHandler:nil];
+    [mListenerDelegate setPingHandler:nil];
+    [mListenerDelegate release];
+    mListenerDelegate = nil;
+  }
+}
+
+- (void)dealloc {
+  [self invalidate];
+  [super dealloc];
+}
+
+@end
+
+NS_ASSUME_NONNULL_END
+
+namespace mozilla::ipc {
+
+void BEProcessCapabilityGrantDeleter::operator()(void* _Nullable aGrant) const {
+}
+
+void NSExtensionProcess::StartProcess(
+    const std::function<void(Result<NSExtensionProcess, LaunchError>&&)>&
+        aCompletion) {
+  auto ownedCompletion = std::make_shared<
+      std::function<void(Result<NSExtensionProcess, LaunchError>&&)>>(
+      aCompletion);
+
+  ExtensionProcess* process = [[ExtensionProcess alloc] init];
+
+  [process startWithCompletion:^(NSError* error) {
+    if (error) {
+      [process release];
+      (*ownedCompletion)(Err(LaunchError("NSExtensionProcess::StartProcess")));
+      return;
+    }
+
+    (*ownedCompletion)(NSExtensionProcess(process));
+  }];
+}
+
+DarwinObjectPtr<xpc_connection_t> NSExtensionProcess::MakeLibXPCConnection() {
+  return AdoptDarwinObject(
+      [static_cast<ExtensionProcess*>(mProcessObject) copyLibXPCConnection]);
+}
+
+void NSExtensionProcess::Invalidate() {
+  [static_cast<ExtensionProcess*>(mProcessObject) invalidate];
+}
+
+UniqueBEProcessCapabilityGrant NSExtensionProcess::GrantForegroundCapability() {
+  return UniqueBEProcessCapabilityGrant(nil);
+}
+
+NSExtensionProcess::NSExtensionProcess(const NSExtensionProcess& aOther)
+    : mProcessObject(aOther.mProcessObject) {
+  [static_cast<ExtensionProcess*>(mProcessObject) retain];
+}
+
+NSExtensionProcess& NSExtensionProcess::operator=(
+    const NSExtensionProcess& aOther) {
+  void* oldProcessObject = std::exchange(mProcessObject, aOther.mProcessObject);
+  [static_cast<ExtensionProcess*>(mProcessObject) retain];
+  [static_cast<ExtensionProcess*>(oldProcessObject) release];
+  return *this;
+}
+
+NSExtensionProcess::~NSExtensionProcess() {
+  [static_cast<ExtensionProcess*>(mProcessObject) release];
+}
+
+void LockdownNSExtensionProcess(NSExtensionSandboxRevision aRevision) {
+  if (id<GeckoProcessExtension> process = GetCurrentProcessExtension()) {
+    switch (aRevision) {
+      case NSExtensionSandboxRevision::Revision1:
+        [process lockdownSandbox:@"1.0"];
+        return;
+      default:
+        NSLog(@"Unknown NSExtension sandbox revision");
+        return;
+    }
+  }
+}
+
+}  // namespace mozilla::ipc
